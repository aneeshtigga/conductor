# Copy to .env and fill in. Never commit .env.

# Anthropic API key (backend only — never exposed to the frontend)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection for seeding / admin (full privileges)
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Postgres connection used at request time — a READ-ONLY role
DATABASE_URL_READONLY=postgresql://readonly_user:pass@host:5432/postgres

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Port
PORT=4000

NODE_ENV=development
