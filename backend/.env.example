# Copy to .env and fill in. Never commit .env.

# LLM provider: "cli" shells to the local `claude` CLI (uses your Claude Code auth, no API key —
# local only), "anthropic" uses the SDK + key (works in the cloud). Default: anthropic.
LLM_PROVIDER=cli

# Anthropic API key — required only when LLM_PROVIDER=anthropic. Backend only, never exposed to FE.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection for seeding / admin (full privileges)
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Postgres connection used at request time — a READ-ONLY role
DATABASE_URL_READONLY=postgresql://readonly_user:pass@host:5432/postgres

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Port
PORT=4000

NODE_ENV=development
